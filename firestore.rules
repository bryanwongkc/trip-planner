rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userOwnsProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function validUserProfile() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'onboardingDemoCreated',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == request.auth.uid &&
      request.resource.data.email == (('email' in request.auth.token) ? request.auth.token.email : '') &&
      request.resource.data.displayName == (('name' in request.auth.token) ? request.auth.token.name : '') &&
      request.resource.data.photoURL == (('picture' in request.auth.token) ? request.auth.token.picture : '') &&
      (!('onboardingDemoCreated' in request.resource.data) ||
        request.resource.data.onboardingDemoCreated is bool);
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function memberRole(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role;
    }

    function canViewTrip(tripId) {
      return isTripMember(tripId);
    }

    function isOwnDemoTripId(tripId) {
      return isSignedIn() && tripId == ('demo-' + request.auth.uid);
    }

    function canEditTrip(tripId) {
      return canViewTrip(tripId) &&
        memberRole(tripId) in ['owner', 'admin', 'editor'];
    }

    function isTripMemberAfter(tripId) {
      return isSignedIn() &&
        existsAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function memberRoleAfter(tripId) {
      return getAfter(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid)).data.role;
    }

    function canEditTripAfter(tripId) {
      return isTripMemberAfter(tripId) &&
        memberRoleAfter(tripId) in ['owner', 'admin', 'editor'];
    }

    function isTripOwner(tripId) {
      return canViewTrip(tripId) && memberRole(tripId) == 'owner';
    }

    function canManageTripMembers(tripId) {
      return isSignedIn() && (
        (canViewTrip(tripId) && memberRole(tripId) in ['owner', 'admin']) ||
        get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid
      );
    }

    function canDeleteTrip(tripId) {
      return isSignedIn() &&
        canViewTrip(tripId) &&
        memberRole(tripId) == 'owner' &&
        (
          get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid
        );
    }

    function isManagedCollaboratorRole(role) {
      return role in ['admin', 'editor', 'viewer'];
    }

    function isSharedOverrideDoc() {
      return request.resource.data.keys().hasOnly(['days', 'items', 'bookingOptions', 'updatedAt']) &&
        (!('days' in request.resource.data) || request.resource.data.days is map) &&
        (!('items' in request.resource.data) || request.resource.data.items is map) &&
        (!('bookingOptions' in request.resource.data) || request.resource.data.bookingOptions is map);
    }

    function isTripMetaDoc() {
      return request.resource.data.keys().hasOnly([
        'title',
        'startDate',
        'endDate',
        'city',
        'ownerId',
        'createdBy',
        'isDemo',
        'hidden',
        'createdAt',
        'updatedAt'
      ]) &&
      (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool);
    }

    function validTripMember(uid) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'photoURL',
        'role',
        'invitedBy',
        'inviteId',
        'joinedAt',
        'updatedAt'
      ]) &&
      request.resource.data.uid == uid &&
      request.resource.data.role in ['owner', 'admin', 'editor', 'viewer'] &&
      (!('inviteId' in request.resource.data) || request.resource.data.inviteId is string);
    }

    function validTripInvite(inviteId) {
      return request.resource.data.keys().hasOnly([
        'inviteId',
        'tripId',
        'role',
        'title',
        'startDate',
        'endDate',
        'city',
        'isDemo',
        'hidden',
        'active',
        'ownerId',
        'createdBy',
        'createdAt',
        'updatedAt',
        'expiresAt',
        'maxUses',
        'useCount',
        'lastUsedAt',
        'lastUsedBy',
        'revokedAt',
        'revokedBy'
      ]) &&
      request.resource.data.keys().hasAll([
        'inviteId',
        'tripId',
        'role',
        'active',
        'createdBy',
        'createdAt',
        'updatedAt',
        'expiresAt',
        'maxUses',
        'useCount'
      ]) &&
      request.resource.data.inviteId == inviteId &&
      request.resource.data.tripId is string &&
      request.resource.data.role in ['admin', 'editor', 'viewer'] &&
      request.resource.data.active is bool &&
      request.resource.data.createdBy is string &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      request.resource.data.expiresAt is timestamp &&
      request.resource.data.maxUses is int &&
      request.resource.data.maxUses >= 1 &&
      request.resource.data.maxUses <= 50 &&
      request.resource.data.useCount is int &&
      request.resource.data.useCount >= 0 &&
      request.resource.data.useCount <= request.resource.data.maxUses &&
      (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool) &&
      (!('lastUsedAt' in request.resource.data) || request.resource.data.lastUsedAt is timestamp) &&
      (!('lastUsedBy' in request.resource.data) || request.resource.data.lastUsedBy is string) &&
      (!('revokedAt' in request.resource.data) || request.resource.data.revokedAt is timestamp) &&
      (!('revokedBy' in request.resource.data) || request.resource.data.revokedBy is string);
    }

    function inviteCreatorCanManage(invite) {
      return exists(/databases/$(database)/documents/trips/$(invite.tripId)/members/$(invite.createdBy)) &&
        get(/databases/$(database)/documents/trips/$(invite.tripId)/members/$(invite.createdBy)).data.role in ['owner', 'admin'];
    }

    function validTripInviteCreate(inviteId) {
      return validTripInvite(inviteId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.active == true &&
        request.resource.data.useCount == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        !('lastUsedAt' in request.resource.data) &&
        !('lastUsedBy' in request.resource.data) &&
        !('revokedAt' in request.resource.data) &&
        !('revokedBy' in request.resource.data);
    }

    function canAcceptInvite(tripId, uid) {
      return isSignedIn() &&
        ('inviteId' in request.resource.data) &&
        canConsumeInviteForMember(tripId, uid, request.resource.data.inviteId);
    }

    function canConsumeInviteForMember(tripId, uid, inviteId) {
      let invitePath = /databases/$(database)/documents/tripInvites/$(inviteId);
      return exists(/databases/$(database)/documents/trips/$(tripId)) &&
        exists(invitePath) &&
        canConsumeExistingInviteForMember(tripId, uid, inviteId);
    }

    function canConsumeExistingInviteForMember(tripId, uid, inviteId) {
      let invitePath = /databases/$(database)/documents/tripInvites/$(inviteId);
      let invite = get(invitePath).data;
      let nextInvite = getAfter(invitePath).data;
      let membershipPath = /databases/$(database)/documents/users/$(uid)/tripMemberships/$(tripId);
      return invite.tripId == tripId &&
        invite.role == request.resource.data.role &&
        invite.active == true &&
        invite.expiresAt > request.time &&
        invite.useCount < invite.maxUses &&
        inviteCreatorCanManage(invite) &&
        nextInvite.useCount == invite.useCount + 1 &&
        nextInvite.lastUsedBy == request.auth.uid &&
        existsAfter(membershipPath) &&
        getAfter(membershipPath).data.tripId == tripId &&
        getAfter(membershipPath).data.role == invite.role &&
        request.auth.uid == uid &&
        isManagedCollaboratorRole(request.resource.data.role);
    }

    function isInviteConsumption(inviteId) {
      let invite = resource.data;
      let memberPath = /databases/$(database)/documents/trips/$(invite.tripId)/members/$(request.auth.uid);
      let membershipPath = /databases/$(database)/documents/users/$(request.auth.uid)/tripMemberships/$(invite.tripId);
      return isSignedIn() &&
        validTripInvite(inviteId) &&
        inviteCreatorCanManage(invite) &&
        invite.active == true &&
        invite.expiresAt > request.time &&
        invite.useCount < invite.maxUses &&
        !exists(memberPath) &&
        request.resource.data.diff(invite).affectedKeys().hasOnly([
          'active',
          'useCount',
          'lastUsedAt',
          'lastUsedBy',
          'updatedAt'
        ]) &&
        request.resource.data.useCount == invite.useCount + 1 &&
        request.resource.data.active == (request.resource.data.useCount < invite.maxUses) &&
        request.resource.data.lastUsedAt == request.time &&
        request.resource.data.lastUsedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(memberPath) &&
        getAfter(memberPath).data.uid == request.auth.uid &&
        getAfter(memberPath).data.inviteId == inviteId &&
        getAfter(memberPath).data.role == invite.role &&
        existsAfter(membershipPath) &&
        getAfter(membershipPath).data.tripId == invite.tripId &&
        getAfter(membershipPath).data.role == invite.role;
    }

    function isManagerInviteRevocation(inviteId) {
      return isSignedIn() &&
        validTripInvite(inviteId) &&
        canManageTripMembers(resource.data.tripId) &&
        resource.data.active == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'active',
          'revokedAt',
          'revokedBy',
          'updatedAt'
        ]) &&
        request.resource.data.active == false &&
        request.resource.data.revokedAt == request.time &&
        request.resource.data.revokedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
    }

    function validTripMembershipIndex(tripId) {
      return request.resource.data.keys().hasOnly([
        'tripId',
        'role',
        'title',
        'startDate',
        'endDate',
        'city',
        'isDemo',
        'hidden',
        'ownerId',
        'createdBy',
        'updatedAt'
      ]) &&
      request.resource.data.tripId == tripId &&
      request.resource.data.role in ['owner', 'admin', 'editor', 'viewer'] &&
      (!('isDemo' in request.resource.data) || request.resource.data.isDemo is bool);
    }

    function isSafeEditorMembershipMirrorUpdate(tripId) {
      return canEditTripAfter(tripId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'startDate',
          'endDate',
          'city',
          'hidden',
          'updatedAt'
        ]) &&
        request.resource.data.title == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.title &&
        request.resource.data.startDate == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.startDate &&
        request.resource.data.endDate == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.endDate &&
        request.resource.data.city == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.city &&
        request.resource.data.hidden == getAfter(/databases/$(database)/documents/trips/$(tripId)).data.hidden;
    }

    match /users/{uid} {
      allow read: if userOwnsProfile(uid);
      allow create, update: if userOwnsProfile(uid) && validUserProfile();
      allow delete: if false;

      match /tripMemberships/{tripId} {
        allow read: if userOwnsProfile(uid);
        allow create: if validTripMembershipIndex(tripId) && (userOwnsProfile(uid) || canManageTripMembers(tripId));
        allow update: if validTripMembershipIndex(tripId) && (
          userOwnsProfile(uid) ||
          isSafeEditorMembershipMirrorUpdate(tripId) ||
          canManageTripMembers(tripId)
        );
        allow delete: if canDeleteTrip(tripId) ||
          ((userOwnsProfile(uid) || canManageTripMembers(tripId)) && resource.data.role != 'owner');
      }
    }

    match /trips/{tripId} {
      allow read: if canViewTrip(tripId) || isOwnDemoTripId(tripId);
      allow create: if isSignedIn() &&
        isTripMetaDoc() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isTripMetaDoc() &&
        canEditTrip(tripId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        (isTripOwner(tripId) || request.resource.data.hidden == resource.data.hidden);
      allow delete: if canDeleteTrip(tripId);
    }

    match /trips/{tripId}/members/{uid} {
      allow read: if canViewTrip(tripId);
      allow create: if validTripMember(uid) && (
        (canManageTripMembers(tripId) && isManagedCollaboratorRole(request.resource.data.role)) ||
        canAcceptInvite(tripId, uid) ||
        (isSignedIn() &&
          request.auth.uid == uid &&
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid &&
          request.resource.data.role == 'owner')
      );
      allow update: if canManageTripMembers(tripId) &&
        validTripMember(uid) &&
        resource.data.role != 'owner' &&
        isManagedCollaboratorRole(request.resource.data.role) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']) &&
        getAfter(/databases/$(database)/documents/users/$(uid)/tripMemberships/$(tripId)).data.role == request.resource.data.role;
      allow delete: if canDeleteTrip(tripId) ||
        (canManageTripMembers(tripId) && resource.data.role != 'owner');
    }

    match /tripInvites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && canManageTripMembers(resource.data.tripId);
      allow create: if isSignedIn() &&
        validTripInviteCreate(inviteId) &&
        canManageTripMembers(request.resource.data.tripId);
      allow update: if resource.data.tripId == request.resource.data.tripId &&
        resource.data.inviteId == request.resource.data.inviteId &&
        (isManagerInviteRevocation(inviteId) || isInviteConsumption(inviteId));
      allow delete: if isSignedIn() && canManageTripMembers(resource.data.tripId);
    }

    match /trips/{tripId}/overrides/shared {
      allow read: if canViewTrip(tripId);
      allow create, update: if isSharedOverrideDoc() && (canEditTrip(tripId) || canEditTripAfter(tripId));
      allow delete: if canDeleteTrip(tripId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
